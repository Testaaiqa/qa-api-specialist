# Copy these values into your shell or a local .env file (never commit secrets).
# Prefer an authorized QA/staging URL with synthetic test data.
API_BASE_URL=
API_TOKEN=
API_MISSING_USER_ID=
API_TEST_DATA_SYNTHETIC=false
API_ALLOW_PRODUCTION=false

# Required before the evidence report is generated.
QA_DEMAND_ID=
QA_ANALYST_NAME=

# Optional report context (leave empty rather than inventing missing context).
QA_OBJECTIVE=
QA_DEMAND_ORIGIN=
QA_FUNCTIONAL_DESCRIPTION=
QA_BUSINESS_RULES=
QA_ACCEPTANCE_CRITERIA=
QA_DEPENDENCIES=
QA_TEST_SCOPE=
QA_OUT_OF_SCOPE=
QA_REPORTS_DIR=reports
QA_SENSITIVE_FIELDS=
